{
  "about": "Anonymizer rules (platform R8.1, R8.2). Modes: raw keeps text as is; label (title attributes and the selectors below) keeps letter-only words (dates shift, numbers of 3 or more digits and codes are replaced); mark replaces numbers with synthetic marks 0 to 10; every other text node uses text mode, which also replaces letter words with same-length filler unless listed below.",
  "selectors": [
    {
      "select": "table.student-mark-sheet td.mark-score:nth-last-child(2)",
      "mode": "mark"
    },
    {
      "select": ".grade-average",
      "mode": "mark"
    },
    {
      "select": "table.fap-sheet td .badge.bg-success",
      "mode": "mark"
    },
    {
      "select": "table.student-mark-sheet td.mark-score",
      "mode": "raw"
    },
    {
      "select": "table.student-mark-sheet td:nth-last-child(4)",
      "mode": "label"
    },
    {
      "select": "th",
      "mode": "label"
    },
    {
      "select": "thead",
      "mode": "label"
    },
    {
      "select": ".badge",
      "mode": "label"
    },
    {
      "select": ".weekly-timetable-attendance-status",
      "mode": "label"
    },
    {
      "select": "[class*=\"attendance-status--\"]",
      "mode": "label"
    },
    {
      "select": ".grade-status",
      "mode": "label"
    },
    {
      "select": "[title=\"Online\"]",
      "mode": "label"
    },
    {
      "select": "[title=\"Slot\"]",
      "mode": "label"
    },
    {
      "select": ".sheet-group-cell",
      "mode": "label"
    },
    {
      "select": "label",
      "mode": "label"
    },
    {
      "select": "button",
      "mode": "label"
    },
    {
      "select": ".fap-detail-field__label",
      "mode": "label"
    },
    {
      "select": ".fap-page-title__crumb-item",
      "mode": "label"
    },
    {
      "select": ".fap-empty-state",
      "mode": "label"
    },
    {
      "select": ".side-nav-link",
      "mode": "label"
    },
    {
      "select": ".side-nav-title",
      "mode": "label"
    }
  ],
  "labelAttributes": [
    "title"
  ],
